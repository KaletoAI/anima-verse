# Build-Context ist das Repo-Root (docker-compose context: ..). Docker liest
# NUR diese .dockerignore im Context-Root — docker/.dockerignore wird ignoriert.
# Ziel: Context klein halten und Laufzeit-/Dev-Artefakte draussen lassen.

# VCS / Editor / Tooling
.git
.github
.vscode
.idea
.claude

# Python-Laufzeit
.venv
**/__pycache__
*.pyc
*.pyo
.pids

# Frontend-/Client-Quellen: NICHT im Image noetig — die gebauten Assets liegen
# bereits unter static/game_admin/ (committed). Spart den grossen node_modules-Transfer.
# Der Dockerfile kopiert nur app/, static/, shared/, plugins/, worlds/, start.sh,
# fetch_models.sh, pyproject.toml, README.md und docker/docker-entrypoint.sh —
# alles andere hier ist reiner Context-Ballast.
frontend
client3d
packages
node_modules
**/node_modules

# Arbeitsstaende, die nie in ein Image gehoeren.
development_instructions
graphify-out
.superpowers

# Lokale Modell-Binaries (werden im Image via fetch_models.sh / Lazy-Download geholt)
models
*.onnx
*.pth

# Logs / temporaere Dateien
logs
*.log
*.tmp
*.bak

# Per-Welt Laufzeit-Daten, die NICHT mitsollen.
# worlds/demo/world.db wird bewusst mitgenommen (gebackene Demo-Welt),
# aber die Queue-DB + WAL-Seitendateien sind reiner Laufzeit-State.
worlds/*/task_queue.db
worlds/*/*.db-shm
worlds/*/*.db-wal
worlds/*/secrets.json

# Private Skill-Pakete: Symlinks in das separate anima-verse-packs-Repo, das
# AUSSERHALB des Build-Contexts liegt — Docker folgt solchen Links nicht und
# legte sie als tote Links ins Image. Sie gehoeren ohnehin nicht in ein Image
# dieses SFW-Repos. plugins/installed/ ist gitignorierter Marketplace-State.
plugins/attraction
plugins/intimacy
plugins/nsfw_anatomy
plugins/installed

# Docker-eigene Hilfsdateien
docker/storage
