{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_camera_math.mjs",
  "fixtures": {
    "WIDE": { "min_x": -100, "max_x": 100, "min_z": -50, "max_z": 50 },
    "TEN": { "min_x": 10, "max_x": 22, "min_z": -20, "max_z": -4 }
  },
  "cases": [
    { "label": "[1a] no bounds -> the empty-world distance 70", "fn": "fitDistance",
      "args": [null], "expect": 70 },
    { "label": "[1b] -100..100 x -50..50 fits at 335.98 -> capped at 150", "fn": "fitDistance",
      "args": [{ "$fixture": "WIDE" }], "expect": 150 },
    { "label": "[1c] a 12 x 16 world (r = 10) fits at 11.5 / sin 22.5 deg", "fn": "fitDistance",
      "args": [{ "$fixture": "TEN" }], "expect": 30.0509481922, "eps": 1e-9 },
    { "label": "[1d] 60 x 80 (r = 50) fits at 150.25 -> capped at 150", "fn": "fitDistance",
      "args": [{ "min_x": 0, "max_x": 60, "min_z": 0, "max_z": 80 }], "expect": 150 },
    { "label": "[1e] a 0.2 m world fits at 0.425 -> raised to MIN_DIST 0.8", "fn": "fitDistance",
      "args": [{ "min_x": 0, "max_x": 0.2, "min_z": 0, "max_z": 0.2 }], "expect": 0.8 },
    { "label": "[1f] a single point (r = 0) -> 70, never a zero distance", "fn": "fitDistance",
      "args": [{ "min_x": 5, "max_x": 5, "min_z": 7, "max_z": 7 }], "expect": 70 },

    { "label": "[2a] no bounds -> the origin", "fn": "worldCentreXZ",
      "args": [null], "expect": [0, 0] },
    { "label": "[2b] symmetric bounds -> the origin", "fn": "worldCentreXZ",
      "args": [{ "$fixture": "WIDE" }], "expect": [0, 0] },
    { "label": "[2c] 10..22 x -20..-4 -> [16, -12]", "fn": "worldCentreXZ",
      "args": [{ "$fixture": "TEN" }], "expect": [16, -12] },

    { "label": "[3a] at MIN_DIST the overview pitch is its near end, 18", "fn": "basePitchDeg",
      "args": [0.8, 18], "expect": 18 },
    { "label": "[3b] at MAX_DIST it is the far end, 62", "fn": "basePitchDeg",
      "args": [150, 18], "expect": 62 },
    { "label": "[3c] beyond MAX_DIST it stays 62", "fn": "basePitchDeg",
      "args": [400, 18], "expect": 62 },
    { "label": "[3d] below MIN_DIST it stays 18", "fn": "basePitchDeg",
      "args": [0.1, 18], "expect": 18 },
    { "label": "[3e] 7 m: 18 + 44 * sqrt(6.2 / 149.2)", "fn": "basePitchDeg",
      "args": [7, 18], "expect": 26.9694148162, "eps": 1e-9 },
    { "label": "[3f] 75.4 m is zoomK 0.5: 18 + 44 * sqrt(0.5)", "fn": "basePitchDeg",
      "args": [75.4, 18], "expect": 49.1126983722, "eps": 1e-9 },
    { "label": "[3g] embodied near end 8 at 2 m: 8 + 54 * sqrt(1.2 / 149.2)", "fn": "basePitchDeg",
      "args": [2, 8], "expect": 12.842838332, "eps": 1e-9 },
    { "label": "[3h] without a near end it is the overview curve (18)", "fn": "basePitchDeg",
      "args": [7], "expect": 26.9694148162, "eps": 1e-9 },

    { "label": "[4] overview: 40 deg stays 40", "fn": "clampPitchDeg",
      "args": [40, false], "expect": 40 },
    { "label": "[4] overview: 5 deg is raised to 8", "fn": "clampPitchDeg",
      "args": [5, false], "expect": 8 },
    { "label": "[4] overview: 100 deg is held at 85", "fn": "clampPitchDeg",
      "args": [100, false], "expect": 85 },
    { "label": "[4] first person: -50 deg may look up", "fn": "clampPitchDeg",
      "args": [-50, true], "expect": -50 },
    { "label": "[4] first person: -100 deg is held at -85", "fn": "clampPitchDeg",
      "args": [-100, true], "expect": -85 },
    { "label": "[4] first person: 90 deg is held at 85", "fn": "clampPitchDeg",
      "args": [90, true], "expect": 85 },

    { "label": "[5a] one notch out: 80 * e^0.12", "fn": "wheelZoom",
      "args": [80, 100, null, null], "expect": 90.1997481264, "eps": 1e-9 },
    { "label": "[5b] one notch in: 80 * e^-0.12", "fn": "wheelZoom",
      "args": [80, -100, null, null], "expect": 70.9536349374, "eps": 1e-9 },
    { "label": "[5c] far in stops at MIN_DIST 0.8", "fn": "wheelZoom",
      "args": [1, -1000, null, null], "expect": 0.8 },
    { "label": "[5d] far out stops at MAX_DIST 150", "fn": "wheelZoom",
      "args": [140, 100, null, null], "expect": 150 },
    { "label": "[5e] the embodied cap 34 binds the wheel", "fn": "wheelZoom",
      "args": [30, 200, 0.8, 34], "expect": 34 },
    { "label": "[5f] a floor of 2 binds the wheel", "fn": "wheelZoom",
      "args": [2.2, -200, 2, null], "expect": 2 },
    { "label": "[5g] a floor below the lens is MIN_DIST", "fn": "wheelZoom",
      "args": [1, -500, 0.5, null], "expect": 0.8 },
    { "label": "[5h] a cap beyond the lens is MAX_DIST", "fn": "wheelZoom",
      "args": [140, 100, null, 500], "expect": 150 },
    { "label": "[5i] a cap below the floor pins the zoom to the floor", "fn": "wheelZoom",
      "args": [5, 0, 2, 1], "expect": 2 },
    { "label": "[5j] deltaY 0 changes nothing", "fn": "wheelZoom",
      "args": [42, 0, null, null], "expect": 42 },

    { "label": "[6a] zooming in 100 -> 80 pulls a fifth of the way to the cursor", "fn": "zoomTowardCursor",
      "args": [[10, 0, 10], [20, 30], 100, 80], "expect": [12, 0, 14] },
    { "label": "[6b] the height is pulled towards the y = 0 plane too", "fn": "zoomTowardCursor",
      "args": [[0, 5, 0], [10, 10], 50, 25], "expect": [5, 2.5, 5] },
    { "label": "[6c] zooming out leaves the target", "fn": "zoomTowardCursor",
      "args": [[1, 2, 3], [10, 10], 50, 60], "expect": [1, 2, 3] },
    { "label": "[6d] no ground under the cursor leaves the target", "fn": "zoomTowardCursor",
      "args": [[1, 2, 3], null, 50, 25], "expect": [1, 2, 3] },
    { "label": "[6e] the same distance leaves the target", "fn": "zoomTowardCursor",
      "args": [[1, 2, 3], [10, 10], 50, 50], "expect": [1, 2, 3] },

    { "label": "[7a] no time, no easing", "fn": "damp",
      "args": [0], "expect": 0 },
    { "label": "[7b] 0.1 s: 1 - e^-0.8", "fn": "damp",
      "args": [0.1], "expect": 0.5506710359, "eps": 1e-9 },
    { "label": "[7c] a 0.5 s stall eases like 0.1 s", "fn": "damp",
      "args": [0.5], "expect": 0.5506710359, "eps": 1e-9 },
    { "label": "[7d] 0.05 s: 1 - e^-0.4", "fn": "damp",
      "args": [0.05], "expect": 0.329679954, "eps": 1e-9 },
    { "label": "[7e] one 60 Hz frame: 1 - e^(-8/60)", "fn": "damp",
      "args": [0.016666666666666666], "expect": 0.124826681, "eps": 1e-9 },

    { "label": "[8] flyAdvance: 0.1 s moves the curve by 0.16", "fn": "flyAdvance",
      "args": [0, 0.1], "expect": 0.16 },
    { "label": "[8] flyAdvance: it stops at 1", "fn": "flyAdvance",
      "args": [0.9, 0.1], "expect": 1 },
    { "label": "[8] flyAdvance: no time, no progress", "fn": "flyAdvance",
      "args": [0.5, 0], "expect": 0.5 },
    { "label": "[8] flyEase: starts at 0", "fn": "flyEase",
      "args": [0], "expect": 0 },
    { "label": "[8] flyEase: ends at 1", "fn": "flyEase",
      "args": [1], "expect": 1 },
    { "label": "[8] flyEase: half way is half way", "fn": "flyEase",
      "args": [0.5], "expect": 0.5 },
    { "label": "[8] flyEase: a quarter in is 0.15625 (slow start)", "fn": "flyEase",
      "args": [0.25], "expect": 0.15625 },
    { "label": "[8] flyEase: three quarters in is 0.84375 (slow end)", "fn": "flyEase",
      "args": [0.75], "expect": 0.84375 },

    { "label": "[9a] a 10 x 20 px drag: yaw - 0.05, pitch + 5", "fn": "orbitStep",
      "args": [0.7853981633974483, 0, 10, 20, false], "expect": { "targetYaw": 0.7353981634, "pitchOffset": 5 }, "eps": 1e-9 },
    { "label": "[9b] the free pitch stops at +35", "fn": "orbitStep",
      "args": [0, 30, 0, 40, false], "expect": { "targetYaw": 0, "pitchOffset": 35 } },
    { "label": "[9c] the free pitch stops at -35", "fn": "orbitStep",
      "args": [0, -30, 0, -40, false], "expect": { "targetYaw": 0, "pitchOffset": -35 } },
    { "label": "[9d] first person passes 35", "fn": "orbitStep",
      "args": [0, 30, 0, 40, true], "expect": { "targetYaw": 0, "pitchOffset": 40 } },
    { "label": "[9d] first person stops at 85", "fn": "orbitStep",
      "args": [0, 80, 0, 40, true], "expect": { "targetYaw": 0, "pitchOffset": 85 } },
    { "label": "[9e] dragging left turns the other way", "fn": "orbitStep",
      "args": [0, 0, -100, 0, false], "expect": { "targetYaw": 0.5, "pitchOffset": 0 } },

    { "label": "[10a] yaw 0, level: the camera on +Z", "fn": "cameraPose",
      "args": [[0, 0, 0], 10, 0, 0], "expect": { "pos": [0, 0, 10] } },
    { "label": "[10b] yaw pi/2, level: the camera on +X", "fn": "cameraPose",
      "args": [[0, 0, 0], 10, 1.5707963267948966, 0], "expect": { "pos": [10, 0, 0] } },
    { "label": "[10c] 90 deg: straight above the target", "fn": "cameraPose",
      "args": [[0, 0, 0], 10, 0, 90], "expect": { "pos": [0, 10, 0] } },
    { "label": "[10d] 30 deg at 20 m from [5, 1, -3]", "fn": "cameraPose",
      "args": [[5, 1, -3], 20, 0, 30], "expect": { "pos": [5, 11, 14.3205080757] }, "eps": 1e-9 },
    { "label": "[10e] yaw pi/4, 45 deg at 10 m", "fn": "cameraPose",
      "args": [[0, 0, 0], 10, 0.7853981633974483, 45], "expect": { "pos": [5, 7.0710678119, 5] }, "eps": 1e-9 }
  ]
}
