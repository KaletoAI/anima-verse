{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_ambience.mjs",
  "fixtures": {
    "NEUTRAL": { "daylight": 1, "tint": [1, 1, 1] },
    "RED_DIM": { "daylight": 0.3, "tint": [1, 0, 0] },
    "SQUARE": [[0, 0], [10, 0], [10, 10], [0, 10]]
  },
  "cases": [
    { "label": "[A1] no ambience -> neutral (daylight 1, white)", "fn": "ambienceTarget", "args": [], "expect": { "daylight": 1, "tint": [1, 1, 1] } },
    { "label": "[A2] daylight 0.3, tint #ff0000 -> sRGB (1, 0, 0), not converted", "fn": "ambienceTarget",
      "args": [{ "daylight": 0.3, "tint": "#ff0000" }], "expect": { "daylight": 0.3, "tint": [1, 0, 0] } },
    { "label": "[A3] a null tint is white", "fn": "ambienceTarget", "args": [{ "daylight": 0.5, "tint": null }],
      "expect": { "daylight": 0.5, "tint": [1, 1, 1] } },
    { "label": "[A4] #ffcf9a -> (255, 207, 154)/255", "fn": "ambienceTarget", "args": [{ "daylight": 1, "tint": "#ffcf9a" }],
      "expect": { "daylight": 1, "tint": [1, 0.8117647058823529, 0.6039215686274509] }, "eps": 1e-12 },

    { "label": "[E1] dt 0.5 = τ: k = 1 − 1/e, daylight 1 − 0.7k = 0.5575156088200097", "fn": "stepAmbience",
      "args": [{ "$fixture": "NEUTRAL" }, { "$fixture": "RED_DIM" }, 0.5],
      "expect": { "daylight": 0.5575156088200097, "tint": [1, 0.36787944117144233, 0.36787944117144233] }, "eps": 1e-12 },
    { "label": "[E2] dt 0 moves nothing", "fn": "stepAmbience", "args": [{ "$fixture": "NEUTRAL" }, { "$fixture": "RED_DIM" }, 0],
      "expect": { "daylight": 1, "tint": [1, 1, 1] } },
    { "label": "[E3] 20 steps of 0.25 s back to neutral: the gap shrinks by e^−10", "fn": "stepAmbienceN",
      "args": [{ "$fixture": "RED_DIM" }, { "$fixture": "NEUTRAL" }, 0.25, 20],
      "expect": { "daylight": 0.9999682200491663, "tint": [1, 0.9999546000702375, 0.9999546000702375] }, "eps": 1e-12 },
    { "label": "[E4] four steps of 0.125 s towards red/dim from neutral", "fn": "stepAmbienceN",
      "args": [{ "$fixture": "NEUTRAL" }, { "$fixture": "RED_DIM" }, 0.125, 4],
      "expect": { "daylight": 0.5575156088200097, "tint": [1, 0.36787944117144233, 0.36787944117144233] }, "eps": 1e-12 },

    { "label": "[N1] noon: day 1 -> night 0", "fn": "nightFactorAt", "args": [12], "expect": 0 },
    { "label": "[N2] midnight: sin(−π/2) clamps to day 0 -> night 1", "fn": "nightFactorAt", "args": [0], "expect": 1 },
    { "label": "[N3] 6:00, the sun on the horizon -> 1", "fn": "nightFactorAt", "args": [6], "expect": 1 },
    { "label": "[N4] 6:30: 1 − 3·sin(π/24) = 0.6084214233398453", "fn": "nightFactorAt", "args": [6.5], "expect": 0.6084214233398453, "eps": 1e-12 },
    { "label": "[N5] 6:48: 1 − 3·sin(π/15) = 0.3762649275467215", "fn": "nightFactorAt", "args": [6.8], "expect": 0.3762649275467215, "eps": 1e-12 },
    { "label": "[N6] 7:00: 1 − 3·sin(π/12) = 0.22354286469243778", "fn": "nightFactorAt", "args": [7], "expect": 0.22354286469243778, "eps": 1e-12 },
    { "label": "[N7] 8:00: 1 − 3·0.5 clamps to 0", "fn": "nightFactorAt", "args": [8], "expect": 0 },
    { "label": "[N8] 18:00, the sun sets -> 1", "fn": "nightFactorAt", "args": [18], "expect": 1 },
    { "label": "[N9] 25 wraps to 1:00 -> 1", "fn": "nightFactorAt", "args": [25], "expect": 1 },
    { "label": "[N10] −12 wraps to noon -> 0", "fn": "nightFactorAt", "args": [-12], "expect": 0 },

    { "label": "[R1] a 4 × 2 hull -> centre (2, 1), size 4 × 2", "fn": "roomRectOf", "args": [[[0, 0], [4, 0], [4, 2], [0, 2]]],
      "expect": { "x": 2, "z": 1, "w": 4, "d": 2 } },
    { "label": "[R2] a 3 × 0.2 sliver -> depth raised to 0.5", "fn": "roomRectOf", "args": [[[0, 0], [3, 0], [3, 0.2], [0, 0.2]]],
      "expect": { "x": 1.5, "z": 0.1, "w": 3, "d": 0.5 }, "eps": 1e-12 },
    { "label": "[R3] an empty hull -> null", "fn": "roomRectOf", "args": [[]], "expect": null },

    { "label": "[R4] the smaller room wins: closet (area 4) inside the hall (area 100)", "fn": "roomAtRects",
      "args": [[["hall", { "x": 0, "z": 0, "w": 10, "d": 10 }], ["closet", { "x": 3, "z": 3, "w": 2, "d": 2 }]], 3.5, 3.5], "expect": "closet" },
    { "label": "[R5] outside the closet -> the hall", "fn": "roomAtRects",
      "args": [[["hall", { "x": 0, "z": 0, "w": 10, "d": 10 }], ["closet", { "x": 3, "z": 3, "w": 2, "d": 2 }]], 0, 0], "expect": "hall" },
    { "label": "[R6] the edge counts as inside: |5 − 0| = 5 = w/2", "fn": "roomAtRects",
      "args": [[["hall", { "x": 0, "z": 0, "w": 10, "d": 10 }]], 5, 0], "expect": "hall" },
    { "label": "[R7] beyond it -> null", "fn": "roomAtRects", "args": [[["hall", { "x": 0, "z": 0, "w": 10, "d": 10 }]], 6, 0], "expect": null },
    { "label": "[R8] equal areas: the first one met stays", "fn": "roomAtRects",
      "args": [[["a", { "x": 0, "z": 0, "w": 2, "d": 2 }], ["b", { "x": 0, "z": 0, "w": 2, "d": 2 }]], 0, 0], "expect": "a" },

    { "label": "[T1] world → tile: centre (10, 20) turned +90°, (12, 20) -> (0, 2)", "fn": "worldToTile",
      "args": [{ "center": { "x": 10, "z": 20 }, "yaw": 1.5707963267948966 }, 12, 20], "expect": { "x": 0, "z": 2 }, "eps": 1e-12 },
    { "label": "[T2] unturned: (4, 6) around (1, 2) -> (3, 4)", "fn": "worldToTile",
      "args": [{ "center": { "x": 1, "z": 2 }, "yaw": 0 }, 4, 6], "expect": { "x": 3, "z": 4 } },
    { "label": "[T3] turned π/6: one metre east -> (cos π/6, sin π/6)", "fn": "worldToTile",
      "args": [{ "center": { "x": 0, "z": 0 }, "yaw": 0.5235987755982988 }, 1, 0], "expect": { "x": 0.8660254037844387, "z": 0.5 }, "eps": 1e-12 },

    { "label": "[C1] the lowest storey ≥ 0 decides: level 0 over level 1, the cellar ignored", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "up", "level": 1, "outline": { "$fixture": "SQUARE" } },
                { "roomId": "ground", "level": 0, "outline": { "$fixture": "SQUARE" } },
                { "roomId": "cellar", "level": -1, "outline": { "$fixture": "SQUARE" } }], 5, 5], "expect": "ground" },
    { "label": "[C2] outside the outline -> null", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "ground", "level": 0, "outline": { "$fixture": "SQUARE" } }], 11, 5], "expect": null },
    { "label": "[C3] only a cellar corridor -> null", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "cellar", "level": -1, "outline": { "$fixture": "SQUARE" } }], 5, 5], "expect": null },
    { "label": "[C4] an outline of two points -> null", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "ground", "level": 0, "outline": [[0, 0], [10, 0]] }], 5, 0], "expect": null },
    { "label": "[C5] half-open: the west edge x = 0 is inside", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "ground", "level": 0, "outline": { "$fixture": "SQUARE" } }], 0, 5], "expect": "ground" },
    { "label": "[C6] half-open: the east edge x = 10 is outside", "fn": "corridorAtOutline",
      "args": [[{ "roomId": "ground", "level": 0, "outline": { "$fixture": "SQUARE" } }], 10, 5], "expect": null }
  ]
}
