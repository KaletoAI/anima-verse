{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_secondary_motion.mjs",
  "fixtures": {
    "defaults": {
      "bones": [
        "extra"
      ],
      "freq_hz": 2,
      "zeta": 1,
      "gravity": 1,
      "gravity_scale": 1,
      "translate": 0,
      "flatten": 0,
      "sag_max_deg": 180,
      "spill": 0,
      "gain": 1,
      "max_deg": 180,
      "squash": [
        0.1,
        3
      ],
      "rest_deg": 0,
      "rest_max_deg": 90
    },
    "target": {
      "bones": [
        "extra"
      ],
      "freq_hz": 0,
      "zeta": 0,
      "gravity": 0.4,
      "gravity_scale": 1,
      "translate": 0,
      "flatten": 0.2,
      "sag_max_deg": 180,
      "spill": 0.8,
      "gain": 0,
      "max_deg": 180,
      "squash": [
        0.1,
        3
      ],
      "rest_deg": 0,
      "rest_max_deg": 90
    }
  },
  "cases": [
    {
      "label": "[B1] midpoint multipliers",
      "fn": "blendMotionParams",
      "args": [
        {
          "$fixture": "defaults"
        },
        {
          "$fixture": "target"
        },
        0.75
      ],
      "expect": {
        "gravity": 0.7,
        "gain": 0.5,
        "freq_hz": 1,
        "flatten": 0.1,
        "spill": 0.4,
        "zeta": 0.5
      }
    },
    {
      "label": "[B2] endpoint gain",
      "fn": "blendMotionParams",
      "args": [
        {
          "$fixture": "defaults"
        },
        {
          "$fixture": "target"
        },
        1.5
      ],
      "expect": {
        "gain": 0
      }
    },
    {
      "label": "[B3] negative elapsed clamps to start",
      "fn": "blendMotionParams",
      "args": [
        {
          "$fixture": "defaults"
        },
        {
          "$fixture": "target"
        },
        -1
      ],
      "expect": {
        "gravity": 1,
        "gain": 1,
        "freq_hz": 2
      }
    },
    {
      "label": "[B3] elapsed beyond duration clamps to end",
      "fn": "blendMotionParams",
      "args": [
        {
          "$fixture": "defaults"
        },
        {
          "$fixture": "target"
        },
        3
      ],
      "expect": {
        "gravity": 0.4,
        "gain": 0,
        "freq_hz": 0
      }
    },
    {
      "label": "[B4] extent midpoint and optional fallbacks",
      "fn": "blendMotionParams",
      "args": [
        {
          "$fixture": "defaults",
          "$with": {
            "length": 1.5,
            "girth": 0.8
          }
        },
        {
          "$fixture": "defaults",
          "$with": {
            "length": 0.5,
            "girth": 2
          }
        },
        0.75
      ],
      "expect": {
        "length": 1,
        "girth": 1.4,
        "spread": 0.5,
        "head_sag": 1,
        "flatten_floor": 0.1
      }
    }
  ]
}
