{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_walk_math.mjs",
  "fixtures": {
    "LOC": {"id": "loc1", "name": "Home", "rooms": [{"id": "r1", "name": "Kitchen"}, {"id": "r2", "name": "Hall"}]},
    "PLACED": {"id": "L1", "name": "Home", "rooms": [{"id": "r1", "name": "Kitchen"}, {"id": "r2", "name": "Hall"}], "pos_x": 0, "pos_z": 0},
    "CHARS": [{"name": "A", "movement_target_name": "Harbor", "travel": {"eta_hhmm": "14:30"}}, {"name": "B"}, {"name": "C"}],
    "ROOM_OF": {"A": "Kitchen", "B": "r2"},
    "EVENTS": [{"category": "danger", "text": "Fire"}, {"category": "other", "text": "News"}]
  },
  "cases": [
    {"label": "[B1] a short line passes through unchanged", "fn": "bubbleText", "args": ["Yes."], "expect": "Yes."},
    {"label": "[B2] surrounding whitespace goes", "fn": "bubbleText", "args": ["  Yes.  "], "expect": "Yes."},
    {"label": "[B3] inner whitespace collapses to single spaces", "fn": "bubbleText", "args": ["one\n\ntwo   three\tfour"], "expect": "one two three four"},
    {"label": "[B4] whitespace only yields the empty string", "fn": "bubbleText", "args": ["   \n  "], "expect": ""},
    {"label": "[B5] 140 characters are still shown in full", "fn": "bubbleText", "args": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    {"label": "[B6] 141 characters are cut to 139 + the ellipsis", "fn": "bubbleText", "args": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa…"},
    {"label": "[B7] a cut on a space does not leave one hanging", "fn": "bubbleText", "args": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb cccccccccccccccccccc"], "expect": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb…"},
    {"label": "[B8] short line: 3500 + 55*4", "fn": "bubbleMs", "args": ["Yes."], "expect": 3720},
    {"label": "[B9] nothing to say is still the base", "fn": "bubbleMs", "args": [""], "expect": 3500},
    {"label": "[B10] 100 characters: 3500 + 5500", "fn": "bubbleMs", "args": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], "expect": 9000},
    {"label": "[B11] 154 characters stay just under the ceiling", "fn": "bubbleMs", "args": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], "expect": 11970},
    {"label": "[B12] 155 characters are the first to clamp", "fn": "bubbleMs", "args": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], "expect": 12000},
    {"label": "[B13] a very long line clamps too", "fn": "bubbleMs", "args": [""], "expect": 12000},
    {"label": "[B14] the duration counts what was SAID, not what is shown", "fn": "bubbleMs", "args": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"], "expect": 12000},
    {"label": "[B15] duration uses the collapsed length", "fn": "bubbleMs", "args": [" a \n b "], "expect": 3665},
    {"label": "[P1] (none) -> 0 / world", "fn": "bootProgress", "args": [[]], "expect": {"percent": 0, "label": "world"}},
    {"label": "[P1] world -> 17 / scenes", "fn": "bootProgress", "args": [["world"]], "expect": {"percent": 17, "label": "scenes"}},
    {"label": "[P1] world,scenes -> 33 / tiles", "fn": "bootProgress", "args": [["world", "scenes"]], "expect": {"percent": 33, "label": "tiles"}},
    {"label": "[P1] world,scenes,tiles -> 50 / visible", "fn": "bootProgress", "args": [["world", "scenes", "tiles"]], "expect": {"percent": 50, "label": "visible"}},
    {"label": "[P1] world,scenes,tiles,visible -> 67 / figures", "fn": "bootProgress", "args": [["world", "scenes", "tiles", "visible"]], "expect": {"percent": 67, "label": "figures"}},
    {"label": "[P1] world,scenes,tiles,visible,figures -> 83 / arrival", "fn": "bootProgress", "args": [["world", "scenes", "tiles", "visible", "figures"]], "expect": {"percent": 83, "label": "arrival"}},
    {"label": "[P1] world,scenes,tiles,visible,figures,arrival -> 100 / ready", "fn": "bootProgress", "args": [["world", "scenes", "tiles", "visible", "figures", "arrival"]], "expect": {"percent": 100, "label": "ready"}},
    {"label": "[P2] figures -> 17 / world", "fn": "bootProgress", "args": [["figures"]], "expect": {"percent": 17, "label": "world"}},
    {"label": "[P2] world,figures,tiles -> 50 / scenes", "fn": "bootProgress", "args": [["world", "figures", "tiles"]], "expect": {"percent": 50, "label": "scenes"}},
    {"label": "[P2] world,figures,scenes,arrival -> 67 / tiles", "fn": "bootProgress", "args": [["world", "figures", "scenes", "arrival"]], "expect": {"percent": 67, "label": "tiles"}},
    {"label": "[P2] arrival,figures,visible,tiles,scenes,world -> 100 / ready", "fn": "bootProgress", "args": [["arrival", "figures", "visible", "tiles", "scenes", "world"]], "expect": {"percent": 100, "label": "ready"}},
    {"label": "[P3] world,bogus -> 17 / scenes", "fn": "bootProgress", "args": [["world", "bogus"]], "expect": {"percent": 17, "label": "scenes"}},
    {"label": "[P3] bogus,other -> 0 / world", "fn": "bootProgress", "args": [["bogus", "other"]], "expect": {"percent": 0, "label": "world"}},
    {"label": "[I1] a forest location lists no rooms", "fn": "infoPanelData", "args": [{"$fixture": "LOC", "$with": {"terrain": "forest"}}, {"$fixture": "CHARS"}, [], {"$fixture": "ROOM_OF"}, null, null], "expect": {"rooms": []}},
    {"label": "[I2] an area model lists no rooms", "fn": "infoPanelData", "args": [{"$fixture": "LOC", "$with": {"map3d": {"area_model": "area"}}}, {"$fixture": "CHARS"}, [], {"$fixture": "ROOM_OF"}, null, null], "expect": {"rooms": []}},
    {"label": "[I3] rooms in order, matched by room name or id", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, {"$fixture": "CHARS"}, {"$fixture": "EVENTS"}, {"$fixture": "ROOM_OF"}, null, null], "expect": {"rooms": [{"name": "Kitchen", "who": ["A"]}, {"name": "Hall", "who": ["B"]}]}},
    {"label": "[I4] everyone present, in order, absent fields empty", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, {"$fixture": "CHARS"}, {"$fixture": "EVENTS"}, {"$fixture": "ROOM_OF"}, null, null], "expect": {"present": [{"name": "A", "activity": "", "mood": "", "travelTo": "Harbor", "eta": "14:30"}, {"name": "B", "activity": "", "mood": "", "travelTo": "", "eta": ""}, {"name": "C", "activity": "", "mood": "", "travelTo": "", "eta": ""}]}},
    {"label": "[I5] events carry danger only for the danger category", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, {"$fixture": "CHARS"}, {"$fixture": "EVENTS"}, {"$fixture": "ROOM_OF"}, null, null], "expect": {"events": [{"danger": true, "text": "Fire"}, {"danger": false, "text": "News"}]}},
    {"label": "[I6] no view given -> null", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, {"$fixture": "CHARS"}, {"$fixture": "EVENTS"}, {"$fixture": "ROOM_OF"}, null, null], "expect": {"view": null}},
    {"label": "[I7] no description -> empty", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, {"$fixture": "CHARS"}, {"$fixture": "EVENTS"}, {"$fixture": "ROOM_OF"}, null, null], "expect": {"description": ""}},
    {"label": "[I8] a given view is copied", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, [], [], {"$fixture": "ROOM_OF"}, {"openable": true, "open": false}, null], "expect": {"view": {"openable": true, "open": false}}},
    {"label": "[I9] the avatar elsewhere: distance hypot(3, 4) = 5", "fn": "infoPanelData", "args": [{"$fixture": "PLACED"}, [], [], {"$fixture": "ROOM_OF"}, null, {"locationId": "L2", "pos": {"x": 3, "z": 4}}], "expect": {"travel": {"distanceM": 5}}},
    {"label": "[I10] the avatar in this location: no travel", "fn": "infoPanelData", "args": [{"$fixture": "PLACED", "$with": {"id": "L2"}}, [], [], {"$fixture": "ROOM_OF"}, null, {"locationId": "L2", "pos": {"x": 3, "z": 4}}], "expect": {"travel": null}},
    {"label": "[I11] no avatar: no travel", "fn": "infoPanelData", "args": [{"$fixture": "PLACED"}, [], [], {"$fixture": "ROOM_OF"}, null, null], "expect": {"travel": null}},
    {"label": "[I12] a location without a position: travel without distance", "fn": "infoPanelData", "args": [{"$fixture": "LOC"}, [], [], {"$fixture": "ROOM_OF"}, null, {"locationId": "L2", "pos": {"x": 3, "z": 4}}], "expect": {"travel": {"distanceM": null}}},
    {"label": "[J3] 20 / 40 / 300 is taken as typed", "fn": "checkScatterPrefs", "args": [20, 40, 300], "expect": {"ok": true, "prefs": {"scatterNearM": 20, "scatterFarM": 40, "scatterCullM": 300}}},
    {"label": "[J3] a 3 is taken, clamped up to 5", "fn": "checkScatterPrefs", "args": [3, 10, 50], "expect": {"ok": true, "prefs": {"scatterNearM": 5, "scatterFarM": 10, "scatterCullM": 50}}},
    {"label": "[J3] near above far is refused as unordered", "fn": "checkScatterPrefs", "args": [40, 20, 300], "expect": {"ok": false, "error": "order"}},
    {"label": "[J3] equal is not ordered either", "fn": "checkScatterPrefs", "args": [20, 40, 40], "expect": {"ok": false, "error": "order"}},
    {"label": "[J3] a string is refused as no number", "fn": "checkScatterPrefs", "args": ["30", 45, 120], "expect": {"ok": false, "error": "number"}},
    {"label": "[J3] three values colliding at the ceiling are refused, not drawn", "fn": "checkScatterPrefs", "args": [2500, 3000, 4000], "expect": {"ok": false, "error": "order"}},
    {"label": "[J4] the stored fields become a cfg", "fn": "scatterLodCfgOf", "args": [{"scatterNearM": 20, "scatterFarM": 40, "scatterCullM": 300}], "expect": {"nearM": 20, "farM": 40, "cullM": 300}}
  ]
}
