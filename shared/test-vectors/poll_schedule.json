    { "label": "[P1e] factor 8 on 5000 is 40000, under the ceiling", "fn": "pollIntervalMs",
      "args": [5000, 0, 8], "expect": 40000 },
    { "label": "[P1f] factor 16 on 5000 would be 80000 -> 60000", "fn": "pollIntervalMs",
      "args": [5000, 0, 16], "expect": 60000 },
    { "label": "[P1g] a slow endpoint stays slow: 120000 backs off to itself", "fn": "pollIntervalMs",
      "args": [120000, 0, 4], "expect": 120000 },
    { "label": "[P1h] the minimum spacing wins over a shorter base", "fn": "pollIntervalMs",
