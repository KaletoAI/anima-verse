{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_ground_math.mjs",
  "fixtures": {
    "TRIANGLE": [[0, 0], [10, 0], [0, 6]],
    "TRIANGLE_CW": [[0, 0], [0, 6], [10, 0]],
    "SQUARE": [[0, 0], [0, 1], [1, 1], [1, 0]],
    "L_SHAPE": [[0, 0], [6, 0], [6, 2], [2, 2], [2, 5], [0, 5]],
    "L_SHAPE_REV": [[0, 5], [2, 5], [2, 2], [6, 2], [6, 0], [0, 0]],
    "COLLINEAR": [[0, 0], [5, 0], [10, 0]],
    "POND": [[0, 0], [12, 0], [12, 8], [2, 8], [0, 6]]
  },
  "cases": [
    { "label": "[T] signedArea: triangle, counter-clockwise in world XZ", "fn": "signedArea",
      "args": [{ "$fixture": "TRIANGLE" }], "expect": 30 },
    { "label": "[T'] signedArea: the same triangle the other way round", "fn": "signedArea",
      "args": [{ "$fixture": "TRIANGLE_CW" }], "expect": -30 },
    { "label": "[S] signedArea: unit square", "fn": "signedArea",
      "args": [{ "$fixture": "SQUARE" }], "expect": -1 },
    { "label": "[C] signedArea: concave L", "fn": "signedArea",
      "args": [{ "$fixture": "L_SHAPE" }], "expect": 18 },
    { "label": "[C'] signedArea: the L reversed", "fn": "signedArea",
      "args": [{ "$fixture": "L_SHAPE_REV" }], "expect": -18 },
    { "label": "[D] signedArea: three collinear points enclose nothing", "fn": "signedArea",
      "args": [{ "$fixture": "COLLINEAR" }], "expect": 0 },
    { "label": "[P] signedArea: bevelled pond", "fn": "signedArea",
      "args": [{ "$fixture": "POND" }], "expect": 94 },
    { "label": "[signedArea] fewer than three points is no ring", "fn": "signedArea",
      "args": [[[0, 0], [1, 1]]], "expect": 0 },

    { "label": "[T] polygonArea: triangle", "fn": "polygonArea",
      "args": [{ "$fixture": "TRIANGLE" }], "expect": 30 },
    { "label": "[T'] polygonArea: reversed triangle, SAME area", "fn": "polygonArea",
      "args": [{ "$fixture": "TRIANGLE_CW" }], "expect": 30 },
    { "label": "[S] polygonArea: unit square", "fn": "polygonArea",
      "args": [{ "$fixture": "SQUARE" }], "expect": 1 },
    { "label": "[C] polygonArea: concave L", "fn": "polygonArea",
      "args": [{ "$fixture": "L_SHAPE" }], "expect": 18 },
    { "label": "[C'] polygonArea: reversed L, SAME area", "fn": "polygonArea",
      "args": [{ "$fixture": "L_SHAPE_REV" }], "expect": 18 },
    { "label": "[D] polygonArea: degenerate strip", "fn": "polygonArea",
      "args": [{ "$fixture": "COLLINEAR" }], "expect": 0 },
    { "label": "[P] polygonArea: bevelled pond", "fn": "polygonArea",
      "args": [{ "$fixture": "POND" }], "expect": 94 },
    { "label": "[T] polygonArea: a repeated first corner changes nothing", "fn": "polygonArea",
      "args": [[[0, 0], [10, 0], [0, 6], [0, 0]]], "expect": 30 },

    { "label": "[cleanRing] the closing duplicate goes", "fn": "cleanRing",
      "args": [[[0, 0], [10, 0], [0, 6], [0, 0]]], "expect": [[0, 0], [10, 0], [0, 6]] },
    { "label": "[cleanRing] consecutive duplicates collapse", "fn": "cleanRing",
      "args": [[[0, 0], [0, 0], [10, 0], [0, 6]]], "expect": [[0, 0], [10, 0], [0, 6]] },
    { "label": "[cleanRing] a two-point ring is no ring at all", "fn": "cleanRing",
      "args": [[[0, 0], [10, 0]]], "expect": [] },
    { "label": "[cleanRing] the concave L survives unchanged", "fn": "cleanRing",
      "args": [{ "$fixture": "L_SHAPE" }], "expect": [[0, 0], [6, 0], [6, 2], [2, 2], [2, 5], [0, 5]] },
    { "label": "[cleanRing] a ring that collapses to two distinct points is dropped", "fn": "cleanRing",
      "args": [[[0, 0], [0, 0], [1, 1], [1, 1]]], "expect": [] }
  ]
}
