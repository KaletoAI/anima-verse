{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_room_spots.mjs",
  "fixtures": {
    "SQUARE": [[-1, -1], [1, -1], [1, 1], [-1, 1]],
    "L_ROOM": [[0, 0], [6, 0], [6, 2], [2, 2], [2, 6], [0, 6]],
    "RECT": [[-4, -4], [0, -4], [0, -1], [-4, -1]]
  },
  "cases": [
    {"label": "[1] the square is its own centre", "fn": "polygonCentroid",
     "args": [{"$fixture": "SQUARE"}], "expect": {"x": 0, "z": 0}},
    {"label": "[1] the L-shaped room: (44/20, 44/20)", "fn": "polygonCentroid",
     "args": [{"$fixture": "L_ROOM"}], "expect": {"x": 2.2, "z": 2.2}},
    {"label": "[1] winding does not matter", "fn": "polygonCentroid",
     "args": [[[0, 6], [2, 6], [2, 2], [6, 2], [6, 0], [0, 0]]], "expect": {"x": 2.2, "z": 2.2}},
    {"label": "[1] a two-point ring has no centre", "fn": "polygonCentroid",
     "args": [[[0, 0], [1, 1]]], "expect": null},
    {"label": "[1] …and neither does a collinear one", "fn": "polygonCentroid",
     "args": [[[0, 0], [1, 1], [2, 2]]], "expect": null},
    {"label": "[1] …nor an absent one (null)", "fn": "polygonCentroid",
     "args": [null], "expect": null},

    {"label": "[2] the raster is 6 x 6", "fn": "roomSpotConstants",
     "args": [], "expect": {"SPOT_GRID": 6}},
    {"label": "[2] …over 0.78 of the bounding box", "fn": "roomSpotConstants",
     "args": [], "expect": {"SPOT_SPREAD": 0.78}},
    {"label": "[2] the rectangular room keeps all 36 stands", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "RECT"}, -2, -2.5, 4, 3], "expect": {"length": 36}},
    {"label": "[2] …and the nearest one is (−2.312, −2.734)", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "RECT"}, -2, -2.5, 4, 3], "expect": {"first": {"x": -2.312, "z": -2.734}}},
    {"label": "[2] …at 0.39 m from the centre", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "RECT"}, -2, -2.5, 4, 3], "expect": {"firstDist": 0.39}},
    {"label": "[2] the L-shaped room drops the 16 points of its cut-out quadrant", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "L_ROOM"}, 3, 3, 6, 6], "expect": {"length": 20}},
    {"label": "[2] …so the nearest stand is (1.596, 2.532)", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "L_ROOM"}, 3, 3, 6, 6], "expect": {"first": {"x": 1.596, "z": 2.532}}},
    {"label": "[2] …at 1.48 m from the bbox centre (sqrt 2.19024)", "fn": "roomSpotGridHead",
     "args": [{"$fixture": "L_ROOM"}, 3, 3, 6, 6], "expect": {"firstDist": 1.4799459449588015}},
    {"label": "[2] without a hull nothing is filtered", "fn": "roomSpotGridHead",
     "args": [null, 0, 0, 6, 6], "expect": {"length": 36}},
    {"label": "[2] …and a degenerate hull is not a filter either", "fn": "roomSpotGridHead",
     "args": [[[0, 0], [1, 1]], 0, 0, 6, 6], "expect": {"length": 36}},

    {"label": "[4] the seat window is 0.25 … 0.70 m over the floor", "fn": "roomSpotConstants",
     "args": [], "expect": {"SEAT_MIN_M": 0.25, "SEAT_MAX_M": 0.70}},
    {"label": "[4] a body needs 1.6 m by 0.7 m", "fn": "roomSpotConstants",
     "args": [], "expect": {"LIE_LENGTH_M": 1.6, "LIE_WIDTH_M": 0.7}},
    {"label": "[4] a chair (0.45, 0.5 x 0.5) is a seat", "fn": "furnitureUse",
     "args": [0, 0.45, 0.5, 0.5], "expect": "sit"},
    {"label": "[4] a bench (0.45, 1.8 x 0.5) is a seat — too narrow to lie on", "fn": "furnitureUse",
     "args": [0, 0.45, 1.8, 0.5], "expect": "sit"},
    {"label": "[4] a bed (0.55, 2.0 x 1.4) is a place to lie", "fn": "furnitureUse",
     "args": [0, 0.55, 2.0, 1.4], "expect": "lie"},
    {"label": "[4] …whichever way round its sides are given", "fn": "furnitureUse",
     "args": [0, 0.55, 1.4, 2.0], "expect": "lie"},
    {"label": "[4] a table (0.75) is neither", "fn": "furnitureUse",
     "args": [0, 0.75, 1.2, 0.8], "expect": null},
    {"label": "[4] a rug (0.02) is neither", "fn": "furnitureUse",
     "args": [0, 0.02, 2.0, 1.4], "expect": null},
    {"label": "[4] the seat window is inclusive at the bottom", "fn": "furnitureUse",
     "args": [0, 0.25, 0.5, 0.5], "expect": "sit"},
    {"label": "[4] …and at the top", "fn": "furnitureUse",
     "args": [0, 0.70, 0.5, 0.5], "expect": "sit"},
    {"label": "[4] 0.24 is under it", "fn": "furnitureUse",
     "args": [0, 0.24, 0.5, 0.5], "expect": null},
    {"label": "[4] 0.71 is over it", "fn": "furnitureUse",
     "args": [0, 0.71, 0.5, 0.5], "expect": null},
    {"label": "[4] exactly 1.6 x 0.7 is a bed", "fn": "furnitureUse",
     "args": [0, 0.5, 1.6, 0.7], "expect": "lie"},
    {"label": "[4] 1.59 long is a seat", "fn": "furnitureUse",
     "args": [0, 0.5, 1.59, 0.7], "expect": "sit"},
    {"label": "[4] THE FLOOR MOVES WITH THE ROOM: the same chair on storey 1 (floor 2.90)", "fn": "furnitureUse",
     "args": [2.90, 3.35, 0.5, 0.5], "expect": "sit"},
    {"label": "[4] …and measured against zero it would be nothing at all", "fn": "furnitureUse",
     "args": [0, 3.35, 0.5, 0.5], "expect": null},

    {"label": "[6] the room's own lattice answers first", "fn": "roomFloorLadder",
     "args": [2, 2.5, 0.3, 1], "expect": 2.5},
    {"label": "[6] else the declaration, over the datum", "fn": "roomFloorLadder",
     "args": [2, null, 0.3, 1], "expect": 2.3},
    {"label": "[6] a declaration of 0 is a value: the datum, not the terrain", "fn": "roomFloorLadder",
     "args": [2, null, 0, 5], "expect": 2},
    {"label": "[6] no declaration: the terrain", "fn": "roomFloorLadder",
     "args": [2, null, null, 1.7], "expect": 1.7},
    {"label": "[6] …even below the datum", "fn": "roomFloorLadder",
     "args": [2, null, null, -0.5], "expect": -0.5},
    {"label": "[6] a terrain sampler with nothing to say: the datum", "fn": "roomFloorLadder",
     "args": [2, null, null, {"$number": "NaN"}], "expect": 2},
    {"label": "[6] the standing height is the floor plus the clearance", "fn": "roomStandLadder",
     "args": [2.3, 9], "expect": 2.31},
    {"label": "[6] a floor at 0 is a floor", "fn": "roomStandLadder",
     "args": [0, 1], "expect": 0.01},
    {"label": "[6] a room without a floor (a corridor) stands at its centre", "fn": "roomStandLadder",
     "args": [null, 4.81], "expect": 4.81},
    {"label": "[6] a room the tile does not know: no height", "fn": "roomStandLadder",
     "args": [null, null], "expect": null},

    {"label": "[7] the turned rectangle: centre, floor, sit/lie surfaces and marker heights", "fn": "roomSpotsOfValue",
     "args": [{
       "hull": {"$fixture": "RECT"},
       "frame": {"center": {"x": 10, "y": 1, "z": 20}, "yaw": 1.5707963267948966},
       "floorAt": [0.1, 0.2, 1.5],
       "baseFloorAt": [0.1, 0.2, 1.4],
       "props": [
         {"min": {"x": 7, "y": 0.8, "z": 21}, "max": {"x": 7.5, "y": 1.25, "z": 21.5}},
         {"min": {"x": 8, "y": 0.8, "z": 22}, "max": {"x": 10, "y": 1.35, "z": 23.4}},
         {"min": {"x": 6, "y": 0.8, "z": 23}, "max": {"x": 7.2, "y": 1.55, "z": 23.8}},
         {"min": {"x": 6, "y": 0.8, "z": 20}, "max": {"x": 6.4, "y": 1.4, "z": 20.4}}],
       "markers": [
         {"slots": [{"x": 8, "y": 0, "z": 21}, {"x": 9, "y": 0, "z": 21}], "drop": 0.4, "offsetY": 0.45},
         {"slots": [{"x": 8, "y": 0, "z": 21}], "drop": 0.4, "offsetY": 0.45, "fixed": true},
         {"slots": [], "drop": 0, "offsetY": 0},
         {"slots": [{"x": 10, "y": 0, "z": 20}], "drop": 0, "offsetY": 0}]}],
     "expect": {
       "rect": {"x": -2, "z": -2.5, "w": 4, "d": 3},
       "centreLocal": {"x": -2, "z": -2.5},
       "centre": {"x": 7.5, "y": 0.81, "z": 22},
       "floorY": 0.8,
       "sit": [{"x": 7.25, "y": 1.26, "z": 21.25}, {"x": 6.2, "y": 1.41, "z": 20.2}],
       "lie": [{"x": 9, "y": 1.36, "z": 22.7}],
       "markerY": [1.05, null, null, 1.4]}},
    {"label": "[7] the L-shaped room stands on the raster point, not on its outside centroid", "fn": "roomSpotsOfValue",
     "args": [{"hull": {"$fixture": "L_ROOM"}, "frame": {"center": {"x": 0, "y": 0, "z": 0}, "yaw": 0},
               "floorAt": [0, 0, 0.3], "baseFloorAt": [0, 0, 0], "props": [], "markers": []}],
     "expect": {"rect": {"x": 3, "z": 3, "w": 6, "d": 6}, "centreLocal": {"x": 1.596, "z": 2.532},
                "centre": {"x": 1.596, "y": 0.31, "z": 2.532}, "floorY": 0.3, "sit": [], "lie": [], "markerY": []}},
    {"label": "[7] a sliver room keeps a 0.5 m rectangle", "fn": "roomSpotsOfValue",
     "args": [{"hull": [[0, 0], [0.2, 0], [0.2, 0.1], [0, 0.1]], "frame": {"center": {"x": 5, "y": 0, "z": 5}, "yaw": 0},
               "floorAt": [0, 0, 0], "baseFloorAt": [0, 0, 0], "props": [], "markers": []}],
     "expect": {"rect": {"x": 0.1, "z": 0.05, "w": 0.5, "d": 0.5}, "centreLocal": {"x": 0.1, "z": 0.05},
                "centre": {"x": 5.1, "y": 0.01, "z": 5.05}, "floorY": 0, "sit": [], "lie": [], "markerY": []}},
    {"label": "[7] a hull without a point has no stands at all", "fn": "roomSpotsOfValue",
     "args": [{"hull": [], "frame": {"center": {"x": 0, "y": 0, "z": 0}, "yaw": 0},
               "floorAt": [0, 0, 0], "baseFloorAt": [0, 0, 0], "props": [], "markers": []}],
     "expect": null}
  ]
}
