{
  "format": "anima-test-vectors/1",
  "source": "scripts/smoke_slot_materials.mjs",
  "cases": [
    { "label": "[1] the material 'picture' takes the picture of the slot 'picture'", "fn": "slotFill",
      "args": ["picture", { "picture": { "image": "/world/locations/loc/gallery/poster.png" } }],
      "expect": { "slot": "picture", "kind": "image", "image": "/world/locations/loc/gallery/poster.png" } },
    { "label": "[3] the glass preset", "fn": "slotFill", "args": ["glass", { "glass": { "preset": "glass" } }],
      "expect": { "slot": "glass", "kind": "glass", "image": "" } },
    { "label": "[4a] an unmatched slot name touches nothing", "fn": "slotFill",
      "args": ["wood", { "picture": { "image": "/world/locations/l/gallery/a.png" } }], "expect": null },
    { "label": "[4b] a value with neither image nor preset touches nothing", "fn": "slotFill", "args": ["picture", { "picture": {} }], "expect": null },
    { "label": "[4c] an unknown preset touches nothing", "fn": "slotFill", "args": ["glass", { "glass": { "preset": "chrome" } }], "expect": null },
    { "label": "[4d] the match is case-insensitive on the MATERIAL name", "fn": "slotFill",
      "args": ["Picture", { "picture": { "image": "/world/locations/l/gallery/a.png" } }],
      "expect": { "slot": "picture", "kind": "image", "image": "/world/locations/l/gallery/a.png" } },
    { "label": "[4e] ...and on the SLOT name", "fn": "slotFill",
      "args": ["picture", { "Picture": { "image": "/world/locations/l/gallery/a.png" } }],
      "expect": { "slot": "picture", "kind": "image", "image": "/world/locations/l/gallery/a.png" } },
    { "label": "[4f] no slots at all is a no-op", "fn": "slotFill", "args": ["picture", null], "expect": null },
    { "label": "[8a] the material slot_picture_1 is the slot picture_1", "fn": "slotFill",
      "args": ["slot_picture_1", { "picture_1": { "image": "/world/locations/demo/gallery/x.png" }, "glass_1": { "preset": "glass" } }],
      "expect": { "slot": "picture_1", "kind": "image", "image": "/world/locations/demo/gallery/x.png" } },
    { "label": "[8b] the material slot_glass_1 is the slot glass_1", "fn": "slotFill",
      "args": ["slot_glass_1", { "picture_1": { "image": "/world/locations/demo/gallery/x.png" }, "glass_1": { "preset": "glass" } }],
      "expect": { "slot": "glass_1", "kind": "glass", "image": "" } },
    { "label": "[8c] RED PROBE: the raw name slot_picture_1 as a key matches nothing", "fn": "slotFill",
      "args": ["slot_picture_1", { "slot_picture_1": { "image": "/world/locations/demo/gallery/x.png" } }], "expect": null },
    { "label": "[8d] RED PROBE: slotpicture_1 (no underscore) is not the slot picture_1", "fn": "slotFill",
      "args": ["slotpicture_1", { "picture_1": { "image": "/world/locations/demo/gallery/x.png" } }], "expect": null },
    { "label": "[8e] exactly ONE prefix is stripped: slot_slot_sign is the slot slot_sign", "fn": "slotFill",
      "args": ["slot_slot_sign", { "slot_sign": { "image": "/world/locations/demo/gallery/s.png" } }],
      "expect": { "slot": "slot_sign", "kind": "image", "image": "/world/locations/demo/gallery/s.png" } },
    { "label": "[8f] the name behind the prefix is trimmed: 'slot_ picture_1' is picture_1", "fn": "slotFill",
      "args": ["slot_ picture_1", { "picture_1": { "image": "/world/locations/demo/gallery/x.png" } }],
      "expect": { "slot": "picture_1", "kind": "image", "image": "/world/locations/demo/gallery/x.png" } },
    { "label": "[9] the mirror preset on slot_glass_1", "fn": "slotFill", "args": ["slot_glass_1", { "glass_1": { "preset": "mirror" } }],
      "expect": { "slot": "glass_1", "kind": "mirror", "image": "" } },
    { "label": "[14] an image wins over a preset and is trimmed", "fn": "slotFill",
      "args": ["glass", { "glass": { "image": " /world/locations/l/gallery/a.png ", "preset": "glass" } }],
      "expect": { "slot": "glass", "kind": "image", "image": "/world/locations/l/gallery/a.png" } },
    { "label": "[15] a preset name is trimmed and case-insensitive", "fn": "slotFill", "args": ["glass", { "glass": { "preset": " Glass " } }],
      "expect": { "slot": "glass", "kind": "glass", "image": "" } },
    { "label": "[16] a blank image falls through to the preset", "fn": "slotFill", "args": ["glass", { "glass": { "image": "  ", "preset": "mirror" } }],
      "expect": { "slot": "glass", "kind": "mirror", "image": "" } },

    { "label": "[3c] what glass MEANS: opacity 0.3, roughness 0.06, metalness 0, transmission 0.85", "fn": "glassPreset", "args": [],
      "expect": { "opacity": 0.3, "roughness": 0.06, "metalness": 0, "transmission": 0.85 } },
    { "label": "[11] the preset list is [glass, mirror]", "fn": "materialPresets", "args": [], "expect": ["glass", "mirror"] }
  ]
}
