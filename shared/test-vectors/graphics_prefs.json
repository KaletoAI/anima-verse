    {"label": "[4] save off, true", "fn": "saveGraphicsPrefs", "args": [{"antiAliasing": "off", "shadows": true, "renderScale": "auto"}], "expect": "{\"antiAliasing\":\"off\",\"shadows\":true,\"renderScale\":\"auto\"}"},
    {"label": "[5] msaa off = 0", "fn": "msaaSamplesOf", "args": ["off"], "expect": 0},
    {"label": "[5] msaa 2x = 2", "fn": "msaaSamplesOf", "args": ["2x"], "expect": 2},
    {"label": "[5] msaa 4x = 4", "fn": "msaaSamplesOf", "args": ["4x"], "expect": 4},
