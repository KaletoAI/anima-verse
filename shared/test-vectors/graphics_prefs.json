{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_graphics_prefs.mjs",
  "comment": "Auto: budget=1920*1080. 1920x1080 and 1600x900 <= budget -> 1; 2560x1440 sqrt(.5625)=.75; 3840x1080 sqrt(.5)=.7071 -> floor .70; 3840x2160 sqrt(.25)=.5; 5120x1440 sqrt(.28125)=.5303 -> floor .5; 7680x2160 sqrt(.125)=.3536 -> floor .35 -> clamp .5. Steps use floor(sqrt(budget/pixels)*20)/20.",
  "cases": [
    {"label": "[1] nothing stored: defaults", "fn": "loadGraphicsPrefs", "args": [null], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[1] empty string: defaults", "fn": "loadGraphicsPrefs", "args": [""], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[1] unparsable text: defaults", "fn": "loadGraphicsPrefs", "args": ["not json"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[1] a JSON array: defaults", "fn": "loadGraphicsPrefs", "args": ["[]"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[1] JSON null: defaults", "fn": "loadGraphicsPrefs", "args": ["null"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[1] a bare level string: defaults", "fn": "loadGraphicsPrefs", "args": ["\"4x\""], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[2] 4x, shadows off", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":\"4x\",\"shadows\":false}"], "expect": {"antiAliasing": "4x", "shadows": false, "renderScale": "auto"}},
    {"label": "[2] off, shadows on", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":\"off\",\"shadows\":true}"], "expect": {"antiAliasing": "off", "shadows": true, "renderScale": "auto"}},
    {"label": "[2] unknown level 8x falls back alone", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":\"8x\",\"shadows\":false}"], "expect": {"antiAliasing": "2x", "shadows": false, "renderScale": "auto"}},
    {"label": "[2] the string \"false\" is not a boolean", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":\"off\",\"shadows\":\"false\"}"], "expect": {"antiAliasing": "off", "shadows": true, "renderScale": "auto"}},
    {"label": "[2] numbers are neither a level nor a switch", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":4,\"shadows\":0}"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[2] levels are case-sensitive, missing switch", "fn": "loadGraphicsPrefs", "args": ["{\"antiAliasing\":\"4X\"}"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[2] empty object: defaults", "fn": "loadGraphicsPrefs", "args": ["{}"], "expect": {"antiAliasing": "2x", "shadows": true, "renderScale": "auto"}},
    {"label": "[3] check 4x, false: ok", "fn": "checkGraphicsPrefs", "args": ["4x", false], "expect": {"ok": true, "prefs": {"antiAliasing": "4x", "shadows": false, "renderScale": "auto"}}},
    {"label": "[3] check off, true: ok", "fn": "checkGraphicsPrefs", "args": ["off", true], "expect": {"ok": true, "prefs": {"antiAliasing": "off", "shadows": true, "renderScale": "auto"}}},
    {"label": "[3] check 8x: refused level", "fn": "checkGraphicsPrefs", "args": ["8x", true], "expect": {"ok": false, "error": "antiAliasing"}},
    {"label": "[3] check \"yes\": refused switch", "fn": "checkGraphicsPrefs", "args": ["off", "yes"], "expect": {"ok": false, "error": "shadows"}},
    {"label": "[3] check null, null: the level is checked first", "fn": "checkGraphicsPrefs", "args": [null, null], "expect": {"ok": false, "error": "antiAliasing"}},
    {"label": "[3] check 2x, 1: refused switch", "fn": "checkGraphicsPrefs", "args": ["2x", 1], "expect": {"ok": false, "error": "shadows"}},
