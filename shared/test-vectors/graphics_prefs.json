{
  "format": "anima-test-vectors/1",
  "source": "client3d/scripts/smoke_graphics_prefs.mjs",
  "cases": [
    { "label": "[1] nothing stored: defaults", "fn": "loadGraphicsPrefs",
      "args": [null], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[1] empty string: defaults", "fn": "loadGraphicsPrefs",
      "args": [""], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[1] unparsable text: defaults", "fn": "loadGraphicsPrefs",
      "args": ["not json"], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[1] a JSON array: defaults", "fn": "loadGraphicsPrefs",
      "args": ["[]"], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[1] JSON null: defaults", "fn": "loadGraphicsPrefs",
      "args": ["null"], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[1] a bare level string: defaults", "fn": "loadGraphicsPrefs",
      "args": ["\"4x\""], "expect": { "antiAliasing": "2x", "shadows": true } },

    { "label": "[2] 4x, shadows off", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":\"4x\",\"shadows\":false}"], "expect": { "antiAliasing": "4x", "shadows": false } },
    { "label": "[2] off, shadows on", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":\"off\",\"shadows\":true}"], "expect": { "antiAliasing": "off", "shadows": true } },
    { "label": "[2] unknown level 8x falls back alone", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":\"8x\",\"shadows\":false}"], "expect": { "antiAliasing": "2x", "shadows": false } },
    { "label": "[2] the string \"false\" is not a boolean", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":\"off\",\"shadows\":\"false\"}"], "expect": { "antiAliasing": "off", "shadows": true } },
    { "label": "[2] numbers are neither a level nor a switch", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":4,\"shadows\":0}"], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[2] levels are case-sensitive, missing switch", "fn": "loadGraphicsPrefs",
      "args": ["{\"antiAliasing\":\"4X\"}"], "expect": { "antiAliasing": "2x", "shadows": true } },
    { "label": "[2] empty object: defaults", "fn": "loadGraphicsPrefs",
      "args": ["{}"], "expect": { "antiAliasing": "2x", "shadows": true } },

    { "label": "[3] check 4x, false: ok", "fn": "checkGraphicsPrefs",
      "args": ["4x", false], "expect": { "ok": true, "prefs": { "antiAliasing": "4x", "shadows": false } } },
    { "label": "[3] check off, true: ok", "fn": "checkGraphicsPrefs",
      "args": ["off", true], "expect": { "ok": true, "prefs": { "antiAliasing": "off", "shadows": true } } },
    { "label": "[3] check 8x: refused level", "fn": "checkGraphicsPrefs",
      "args": ["8x", true], "expect": { "ok": false, "error": "antiAliasing" } },
    { "label": "[3] check \"yes\": refused switch", "fn": "checkGraphicsPrefs",
      "args": ["off", "yes"], "expect": { "ok": false, "error": "shadows" } },
    { "label": "[3] check null, null: the level is checked first", "fn": "checkGraphicsPrefs",
      "args": [null, null], "expect": { "ok": false, "error": "antiAliasing" } },
    { "label": "[3] check 2x, 1: refused switch", "fn": "checkGraphicsPrefs",
      "args": ["2x", 1], "expect": { "ok": false, "error": "shadows" } },

    { "label": "[4] save 4x, false", "fn": "saveGraphicsPrefs",
      "args": [{ "antiAliasing": "4x", "shadows": false }], "expect": "{\"antiAliasing\":\"4x\",\"shadows\":false}" },
    { "label": "[4] save off, true", "fn": "saveGraphicsPrefs",
      "args": [{ "antiAliasing": "off", "shadows": true }], "expect": "{\"antiAliasing\":\"off\",\"shadows\":true}" },

    { "label": "[5] msaa off = 0", "fn": "msaaSamplesOf", "args": ["off"], "expect": 0 },
    { "label": "[5] msaa 2x = 2", "fn": "msaaSamplesOf", "args": ["2x"], "expect": 2 },
    { "label": "[5] msaa 4x = 4", "fn": "msaaSamplesOf", "args": ["4x"], "expect": 4 },

    { "label": "[6] browser antialias for off", "fn": "browserAntialias",
      "args": [{ "antiAliasing": "off", "shadows": true }], "expect": false },
    { "label": "[6] browser antialias for 2x", "fn": "browserAntialias",
      "args": [{ "antiAliasing": "2x", "shadows": true }], "expect": true },
    { "label": "[6] browser antialias for 4x", "fn": "browserAntialias",
      "args": [{ "antiAliasing": "4x", "shadows": false }], "expect": true },

    { "label": "[7] browser Off over 4x", "fn": "pickBrowserAntiAliasing", "args": [false, "4x"], "expect": "off" },
    { "label": "[7] browser Off over off", "fn": "pickBrowserAntiAliasing", "args": [false, "off"], "expect": "off" },
    { "label": "[7] browser On over off picks the default", "fn": "pickBrowserAntiAliasing", "args": [true, "off"], "expect": "2x" },
    { "label": "[7] browser On keeps 2x", "fn": "pickBrowserAntiAliasing", "args": [true, "2x"], "expect": "2x" },
    { "label": "[7] browser On keeps 4x", "fn": "pickBrowserAntiAliasing", "args": [true, "4x"], "expect": "4x" },

    { "label": "[8] storage key, levels and defaults", "fn": "graphicsPrefsConstants", "args": [],
      "expect": { "key": "av3d.view.graphics.v1", "levels": ["off", "2x", "4x"],
                  "defaults": { "antiAliasing": "2x", "shadows": true } } }
  ]
}
