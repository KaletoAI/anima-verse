    {"label": "[7] browser On keeps 2x", "fn": "pickBrowserAntiAliasing", "args": [true, "2x"], "expect": "2x"},
    {"label": "[7] browser On keeps 4x", "fn": "pickBrowserAntiAliasing", "args": [true, "4x"], "expect": "4x"},
