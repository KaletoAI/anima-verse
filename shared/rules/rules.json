{
  "rules": [
    {
      "name": "Exhaustion",
      "name_de": "Erschöpfung",
      "type": "force",
      "condition": "stamina<10",
      "message": "Worn out, going to sleep.",
      "message_de": "Bin erschöpft, gehe schlafen.",
      "force_action": {
        "go_to": "home",
        "set_flags": {
          "is_sleeping": true
        }
      },
      "id": "default_sleep_when_exhausted"
    },
    {
      "name": "Waking up",
      "name_de": "Aufwachen",
      "type": "force",
      "condition": "stamina>70 AND is_sleeping AND NOT schedule:sleeping",
      "message": "Well-rested, waking up.",
      "message_de": "Ausgeschlafen, wache auf.",
      "force_action": {
        "go_to": "stay",
        "set_flags": {
          "is_sleeping": false
        }
      },
      "id": "default_wake_when_rested"
    },
    {
      "name": "Fully rested",
      "name_de": "Ausgeschlafen",
      "type": "force",
      "condition": "stamina>99 AND is_sleeping",
      "message": "You wake up, fully rested.",
      "message_de": "Du wachst auf, da Du ausgeschlafen bist.",
      "force_action": {
        "go_to": "stay",
        "set_flags": {
          "is_sleeping": false
        }
      },
      "id": "rule_f4e31679"
    },
    {
      "name": "Awareness",
      "name_de": "Wahrnehmung",
      "type": "discover",
      "condition": "attention>80",
      "message": "Out of the corner of your eye you notice a place you didn't know yet.",
      "message_de": "Aus dem Augenwinkel fällt dir ein Ort auf, den du noch nicht kanntest.",
      "probability": 0.3,
      "id": "rule_04d219e2"
    },
    {
      "id": "default_courage_danger_gate",
      "name": "Too scared for danger",
      "name_de": "Zu ängstlich für Gefahr",
      "type": "block",
      "target": {
        "scope": "danger_level",
        "min_danger_level": 3,
        "action": "enter"
      },
      "condition": "courage<40",
      "message": "Too scared to go there.",
      "message_de": "Zu ängstlich, um dorthin zu gehen."
    },
    {
      "id": "default_tired_legs",
      "name": "Tired legs",
      "name_de": "Müde Beine",
      "type": "modify",
      "condition": "stamina<30",
      "modify": {
        "quantity": "travel_speed",
        "factor": 0.7
      }
    },
    {
      "id": "default_distracted_eyes",
      "name": "Distracted eyes",
      "name_de": "Unaufmerksame Augen",
      "type": "modify",
      "condition": "attention<25",
      "modify": {
        "quantity": "discovery",
        "factor": 0.6
      }
    },
    {
      "id": "default_alert_eyes",
      "name": "Alert eyes",
      "name_de": "Wachsame Augen",
      "type": "modify",
      "condition": "attention>75",
      "modify": {
        "quantity": "discovery",
        "factor": 1.3
      }
    }
  ]
}
