{
  "name": "anima-verse-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "npm-Workspaces-Wurzel: Game-Admin/Player (frontend), 3D-Client (client3d), geteilte Pakete (packages/*).",
  "workspaces": [
    "frontend",
    "client3d",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w frontend",
    "dev:client3d": "npm run dev -w client3d",
    "build:admin": "npm run build -w frontend",
    "build:client3d": "npm run build -w client3d",
    "build": "npm run build -w frontend && npm run build -w client3d"
  },
  "overrides": {
    "js-yaml@4": "4.3.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@5": "5.0.8"
  }
}
