{
  "name": "anima-verse-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "npm workspaces root: Game-Admin (frontend), HUD page (hud), 3D client (client3d), shared packages (packages/*).",
  "workspaces": [
    "frontend",
    "hud",
    "client3d",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w frontend",
    "dev:hud": "npm run dev -w hud",
    "dev:client3d": "npm run dev -w client3d",
    "build:admin": "npm run build -w frontend",
    "build:hud": "npm run build -w hud",
    "build:client3d": "npm run build -w client3d",
    "lint": "npm run lint -w frontend",
    "build": "npm run build -w frontend && npm run build -w hud && npm run build -w client3d"
  },
  "overrides": {
    "js-yaml@4": "4.3.1",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@5": "5.0.12",
    "source-map-js": "1.2.2",
    "zod@4": "4.6.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
